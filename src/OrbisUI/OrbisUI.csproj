<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrbisUI</AssemblyName>
    <RootNamespace>OrbisUI</RootNamespace>
    <Version>0.4.6</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Low idle footprint: workstation GC without the background GC thread. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OrbisUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL3 (zlib licence) provides native DualShock 4 / DualSense / XInput support. -->
    <None Include="..\..\third_party\SDL3.dll" Link="SDL3.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\third_party\SDL3.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
